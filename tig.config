set mouse = true
set mouse-scroll = 5

#limit author name
set main-view = line-number:no,interval=5 id:no date:default author:full,maxwidth=17 commit-title:yes,graph,refs,overflow=no

#hide marge commits
#set main-options = --no-merges
#set main-view-commit-title-graph = no

#source ~/.config/tig/onedark.tigrc

# One Dark Theme for Tig (256-color palette)

# General UI
color default           250     default
color cursor            255     238     bold
color cursor-blur       250     236
color status            114     default
color title-focus       235     110     bold
color title-blur        250     237
color delimiter         241     default
color header            110     default bold
color section           176     default
color line-number       241     default
color id                180     default
color date              110     default
color author            114     default
color mode              116     default
color overflow          204     default bold
color directory         110     default bold
color file              250     default
color file-size         180     default

# Main View & Graph
color main-tag          204     default bold
color main-local-tag    204     default
color main-remote       180     default
color main-replace      116     default
color main-tracked      114     default bold
color main-ref          116     default
color main-head         176     default bold
color graph-commit      110     default

# Branch Graph Palette
color palette-0         110     default
color palette-1         176     default
color palette-2         114     default
color palette-3         180     default
color palette-4         204     default
color palette-5         116     default
color palette-6         173     default

# Diff & Pager Views
color diff-header       110     default
color diff-index        116     default
color diff-chunk        176     default
color diff-add          114     default
color diff-add2         114     default
color diff-del          204     default
color diff-del2         204     default
color diff-stat         110     default
color "commit "         180     default
color "Author: "        114     default
color "Date: "          110     default
color "Merge: "         176     default

